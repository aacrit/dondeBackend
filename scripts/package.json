{
  "name": "dondeai-pipelines",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "discovery": "tsx pipelines/discovery.ts",
    "enrichment": "tsx pipelines/enrichment.ts",
    "scores": "tsx pipelines/generate-occasion-scores.ts",
    "tags": "tsx pipelines/generate-tags.ts",
    "backfill": "tsx pipelines/backfill-new-fields.ts",
    "populate": "tsx pipelines/populate-all.ts",
    "discovery:targeted": "TARGET_CUISINES=Japanese INCLUDE_VARIANTS=true tsx pipelines/discovery.ts",
    "discovery:gaps": "DRY_RUN=true tsx pipelines/discovery.ts",
    "audit": "tsx pipelines/audit-full-dataset.ts",
    "enrich": "tsx pipelines/enrich-full-dataset.ts",
    "enrich:live": "tsx pipelines/enrich-full-dataset.ts --live",
    "enrich:test": "tsx pipelines/enrich-full-dataset.ts --limit 3",
    "enrich:dishes": "tsx enrich-dishes.ts --live",
    "enrich:dishes:indian": "tsx enrich-dishes.ts --cuisine Indian --live",
    "enrich:dishes:dry": "tsx enrich-dishes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.49.0",
    "undici": "^7.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
